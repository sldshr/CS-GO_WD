<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CsgoWorkshop.App.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush">#CFE4F8</SolidColorBrush>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush">#C2DBF4</SolidColorBrush>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush">#B5D2F0</SolidColorBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="10,3" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#0B57D0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#062E6F" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#062E6F" />
    </Style>
  </Application.Styles>
</Application>

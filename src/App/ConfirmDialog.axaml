<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CsgoWorkshop.App.ConfirmDialog"
        Width="360" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <StackPanel Margin="12" Spacing="12">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
      <Button x:Name="YesButton" Classes="accent" IsDefault="True" />
      <Button x:Name="NoButton" IsCancel="True" Content="Отмена" />
    </StackPanel>
  </StackPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CsgoWorkshop.App"
        x:Class="CsgoWorkshop.App.InstalledWindow"
        Title="Скачанные карты"
        Width="440" Height="320"
        MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Grid Margin="10" RowSpacing="6" RowDefinitions="Auto,*,Auto,Auto">

    <TextBlock x:Name="SummaryText" Foreground="#666666" TextWrapping="Wrap" />

    <Border Grid.Row="1" BorderThickness="1" BorderBrush="#BDBDBD" Background="White">
      <Panel>
        <ListBox x:Name="MapList" Background="Transparent" SelectionMode="Multiple,Toggle">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:MapRow">
              <StackPanel ToolTip.Tip="{Binding Path}">
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock FontSize="11" Foreground="{Binding DetailsBrush}" Text="{Binding Details}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Margin="10" IsVisible="False" TextWrapping="Wrap" Foreground="#666666"
                   Text="Список пуст. Здесь появляются карты, установленные этой программой. Карты, установленные более ранними версиями, в список не попадают." />
      </Panel>
    </Border>

    <TextBlock Grid.Row="2" x:Name="ResultText" IsVisible="False" TextWrapping="Wrap" />

    <Grid Grid.Row="3" ColumnSpacing="6" ColumnDefinitions="Auto,*,Auto">
      <Button x:Name="DeleteButton" IsEnabled="False" Content="Удалить" />
      <Button Grid.Column="2" x:Name="CloseButton" IsCancel="True" Content="Закрыть" />
    </Grid>
  </Grid>
</Window>
